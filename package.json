{
  "name": "my-ckb-project",
  "version": "0.1.0",
  "description": "CKB JavaScript Smart Contract project",
  "private": true,
  "type": "module",
  "scripts": {
    "build:contract": "node scripts/build-contract.js",
    "build:contract:debug": "node scripts/build-contract.js --debug",
    "build": "node scripts/build-all.js",
    "build:debug": "node scripts/build-all.js --debug",
    "deploy": "node scripts/deploy.js",
    "deploy:build": "run-s build deploy",
    "deploy:debug": "run-s build:debug deploy",
    "test": "run-s build test:only",
    "test:only": "jest",
    "add-contract": "node scripts/add-contract.js",
    "clean": "rimraf dist",
    "format": "prettier --write .",
    "transfer": "parcel exercises/simple-transfer/index.html",
    "store-data": "parcel exercises/store-data-on-cell/index.html",
    "create-token": "parcel exercises/create-token/index.html",
    "create-dob": "parcel exercises/create-dob/index.html",
    "simple-lock:build": "npm --prefix exercises/simple-lock run build",
    "simple-lock:deploy": "npm --prefix exercises/simple-lock run deploy -- --network devnet",
    "simple-lock:frontend": "npm --prefix exercises/simple-lock/frontend run dev"
  },
  "dependencies": {
    "@ckb-js-std/bindings": "~1.0.0",
    "@ckb-js-std/core": "~1.0.0",
    "@spore-sdk/core": "^0.2.0-beta.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.2.1",
    "install": "^0.13.0",
    "parcel": "^2.16.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@ckb-ccc/core": "^1.12.2",
    "@types/jest": "~29.5.14",
    "@types/node": "~22.13.8",
    "ckb-testtool": "1.0.5",
    "crypto-browserify": "^3.12.1",
    "esbuild": "~0.25.8",
    "jest": "~29.7.0",
    "npm-run-all": "^4.1.5",
    "path-browserify": "^1.0.1",
    "prettier": "^3.5.3",
    "process": "^0.11.10",
    "rimraf": "^6.0.1",
    "stream-browserify": "^3.0.0",
    "string_decoder": "^1.3.0",
    "ts-jest": "~29.2.6",
    "typescript": "~5.8.2",
    "vm-browserify": "^1.1.2"
  }
}
